Comment: 0,0:00:00.00,0:00:00.00,JA,META.BILINGUAL.P023,0,0,0,,{"kind":"BILINGUAL","pair_id":"P023","source_cue_ids":["U011"],"source_spans":[["U011",24,47]],"speaker_id":"M1","ja_text":"貯まったら景品と交換できるっていうあれでしょ。","vi_text":"đủ điểm thì đổi được quà, là cái đó đúng không?","start":2254.58,"end":2257.91,"ja_event_id":"P023.JA","vi_event_id":"P023.VI","ja_lines":1,"vi_lines":1,"ja_bbox":[497,928,1398,971],"vi_bbox":[427,985,1494,1046],"gap_px":14,"timing_evidence":{"onset":2254.66,"offset":2257.46,"onset_src":"energy","offset_src":"energy"}}
